# Copy to backend/.env for local development.

# Required for generation
OPENAI_API_KEY=
# Models (any Responses-API model that supports Structured Outputs)
OPENAI_MODEL_WRITER=gpt-5
OPENAI_MODEL_FAST=gpt-5-mini

# Optional: USD per 1M tokens, so cost tracking and the monthly budget cap work.
# Fill in from OpenAI's current pricing page for the models above.
OPENAI_PRICE_WRITER_INPUT=0
OPENAI_PRICE_WRITER_OUTPUT=0
OPENAI_PRICE_FAST_INPUT=0
OPENAI_PRICE_FAST_OUTPUT=0

# Single-user login
APP_PASSWORD=changeme
SECRET_KEY=replace-with-a-long-random-string

# Leave empty locally (SQLite + in-process jobs). Railway sets these.
# DATABASE_URL=postgresql://...
# REDIS_URL=redis://...
# COOKIE_SECURE=true
